  "host": "localhost:15680",
  "basePath": "/",
  "paths": {
    "/api/v1/basicservice/basic/travel": {
      "post": {
        "tags": [
          "basic-controller"
        ],
        "summary": "queryForTravel",
        "operationId": "queryForTravelUsingPOST",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "info",
            "description": "info",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Travel"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/BasicTravelResponse"
            }
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/basicservice/basic/{stationName}": {
      "get": {
        "tags": [
          "basic-controller"
        ],
        "summary": "queryForStationId",
        "operationId": "queryForStationIdUsingGET",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "stationName",
            "in": "path",
            "description": "stationName",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/HttpEntity"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "Travel": {
      "type": "object",
      "required": [
        "trip",
        "startingPlace",
        "endPlace"
      ],
      "properties": {
        "trip": {
          "$ref": "#/definitions/Trip"
        },
        "startingPlace": {
          "type": "string",
          "minLength": 1,
          "description": "Station name, resolved via ts-station-service."
        },
        "endPlace": {
          "type": "string",
          "minLength": 1,
          "description": "Station name, resolved via ts-station-service."
        },
        "departureTime": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true,
          "description": "Not used by queryForTravel."
        }
      }
    },
    "Trip": {
      "type": "object",
      "required": [
        "routeId",
        "trainTypeId"
      ],
      "properties": {
        "tripId": {
          "$ref": "#/definitions/TripId",
          "x-nullable": true
        },
        "trainTypeId": {
          "type": "string",
          "minLength": 1,
          "description": "Forwarded to ts-train-service and ts-price-service. An empty or unknown value makes ts-basic-service call /prices/{routeId}/ with an empty segment (HTTP 404, issue F13a)."
        },
        "routeId": {
          "type": "string",
          "format": "uuid",
          "description": "Route ids are UUIDs (ts-route-service init data)."
        },
        "startingStationId": {
          "type": "string",
          "x-nullable": true
        },
        "stationsId": {
          "type": "string",
          "x-nullable": true
        },
        "terminalStationId": {
          "type": "string",
          "x-nullable": true
        },
        "startingTime": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true
        },
        "endTime": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true
        }
      }
    },
    "HttpEntity": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object"
        }
      }
    },
    "ModelAndView": {
      "type": "object",
      "properties": {
        "empty": {
          "type": "boolean"
        },
        "model": {
          "type": "object"
        },
        "modelMap": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "reference": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "100",
            "101",
            "102",
            "103",
            "200",
            "201",
            "202",
            "203",
            "204",
            "205",
            "206",
            "207",
            "208",
            "226",
            "300",
            "301",
            "302",
            "302",
            "303",
            "304",
            "305",
            "307",
            "308",
            "400",
            "401",
            "402",
            "403",
            "404",
            "405",
            "406",
            "407",
            "408",
            "409",
            "410",
            "411",
            "412",
            "413",
            "413",
            "414",
            "414",
            "415",
            "416",
            "417",
            "418",
            "419",
            "420",
            "421",
            "422",
            "423",
            "424",
            "426",
            "428",
            "429",
            "431",
            "451",
            "500",
            "501",
            "502",
            "503",
            "504",
            "505",
            "506",
            "507",
            "508",
            "509",
            "510",
            "511"
          ]
        },
        "view": {
          "$ref": "#/definitions/View"
        },
        "viewName": {
          "type": "string"
        }
      }
    },
    "View": {
      "type": "object",
      "properties": {
        "contentType": {
          "type": "string"
        }
      }
    },
    "TripId": {
      "type": "object",
      "properties": {
        "number": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "G",
            "D",
            "Z",
            "T",
            "K"
          ]
        }
      }
    },
    "TrainType": {
      "type": "object",
      "required": [
        "id",
        "economyClass",
        "confortClass",
        "averageSpeed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "economyClass": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "confortClass": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "averageSpeed": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "description": "km/h; used as divisor by ts-travel-service, so it must be positive."
        }
      }
    },
    "TravelResult": {
      "type": "object",
      "required": [
        "status",
        "percent",
        "prices"
      ],
      "properties": {
        "status": {
          "type": "boolean",
          "description": "false if a station or the train type does not exist."
        },
        "percent": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1,
          "description": "Always 1.0 in BasicServiceImpl.queryForTravel."
        },
        "trainType": {
          "$ref": "#/definitions/TrainType",
          "x-nullable": true
        },
        "prices": {
          "type": "object",
          "required": [
            "economyClass",
            "confortClass"
          ],
          "properties": {
            "economyClass": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$",
              "description": "Price rendered by Double.toString(), e.g. \"175.0\"."
            },
            "confortClass": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$",
              "description": "Price rendered by Double.toString(), e.g. \"175.0\"."
            }
          },
          "description": "Falls back to 95.0 / 120.0 if the route or price config is missing."
        }
      }
    },
    "BasicTravelResponse": {
      "type": "object",
      "description": "Response of BasicServiceImpl.queryForTravel. The Hystrix fallback {status:null,msg:null,data:null} is deliberately not part of the spec.",
      "required": [
        "status",
        "msg",
        "data"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "format": "int32",
          "enum": [
            0,
            1
          ],
          "description": "TrainTicket body status: 1 = success, 0 = business failure (HTTP status is 200 in both cases)."
        },
        "msg": {
          "type": "string",
          "enum": [
            "Success",
            "Start place or end place not exist!",
            "Train type doesn't exist"
          ]
        },
        "data": {
          "$ref": "#/definitions/TravelResult",
          "x-nullable": true
        }
      }
    }
  }
}

  "definitions": {
    "PriceConfig": {
      "type": "object",
      "required": [
        "id",
        "trainType",
        "routeId",
        "basicPriceRate",
        "firstClassPriceRate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "trainType": {
          "type": "string",
          "minLength": 1
        },
        "routeId": {
          "type": "string",
          "format": "uuid"
        },
        "basicPriceRate": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "exclusiveMinimum": true,
          "maximum": 1,
          "description": "Price per distance unit for 2nd class (init data: 0.2 - 0.7)."
        },
        "firstClassPriceRate": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "exclusiveMinimum": true,
          "maximum": 1,
          "description": "Price per distance unit for 1st class (init data: 1.0)."
        }
      }

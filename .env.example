# Configuration of the coverage tool, the build scripts and the web UI.
# Copy this file to .env (not committed) and adjust the paths. .env is the only env file that is read.
# Use whole-line comments only (no "# ..." after a value).

# Microservice system under test: the folder that contains the service folders.
# To switch between systems, comment one block in and the other out.
MICROSERVICES_ROOT=/absolute/path/to/train-ticket
MICROSERVICES_PREFIX=ts-

# Hypertrace agent and its configuration for the test JVM (reports to localhost:4317)
HYPERTRACE_AGENT_PATH=./tracing/hypertrace/hypertrace-agent-1.3.24-all.jar
HYPERTRACE_CONFIG_PATH=./tracing/hypertrace/test-config.yaml

# Root of this repository (used by the web UI)
TOOL_ROOT=/absolute/path/to/reach-aware-coverage
